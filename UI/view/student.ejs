<!DOCTYPE html>
<html>
    <head>
        <title>Student's Home Page</title>
    </head>

    <body>
        <nav style="display:flex; justify-content:space-between; padding:10px; border-bottom:1px solid #ccc;">
            <div>
                <strong>Online Learning Platform</strong> 
            </div>
            <div>
                <a href="/login">Logout</a>
            </div>
        </nav>
        <h2>My Enrolled Course and Assignment Grade</h2>
        <form>
            Name: <%= student.name%> <br>
            Student No:  <%= student.studNo%><br>
            Phone: <%= student.phone%><br>
        </form>
        <h2 style="color: cornflowerblue;">My Enrolled Courses</h2>
        <form>
            Course: <%=student.couse%> <br>
            <br><br>
            Grade: <%=student.grade%> <br>
        </form>
        
        <h2 style="color: cornflowerblue;">My Assignment</h2>
        
        <a href="/assignment" style="display: inline-block; padding: 8px 16px; background-color: #ccc; text-decoration: none; border-radius: 4px; color: #000;">Start your assignment</a>

    </body>
</html>
